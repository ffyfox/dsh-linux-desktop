{
  "name": "dsh-linux-desktop",
  "version": "0.5.1",
  "description": "DeepSeek Harness 的 Linux 原生桌面集成：XDG 桌面入口、纯净无边框独立窗口，以及由自己启动的服务随窗口关闭而停止的生命周期管理。",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cli": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-desktop": "bin/dsh-desktop.js"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node scripts/prepublish-check.mjs",
    "check:pre-commit": "node scripts/prepublish-check.mjs --pre-commit",
    "release": "node scripts/release.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "pack:tag": "node scripts/pack-from-tag.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo '已启用 .githooks/ —— 提交前会自动跑 npm run check:pre-commit；急事用 git commit --no-verify 跳过'",
    "prepublishOnly": "node scripts/prepublish-check.mjs --release",
    "status": "node bin/dsh-desktop.js status"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "linux",
    "desktop",
    "xdg",
    "freedesktop",
    "wayland",
    "x11",
    "kde",
    "gnome",
    "chromium",
    "pwa",
    "launcher"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffyfox/dsh-linux-desktop.git"
  },
  "author": "ffyfox",
  "homepage": "https://github.com/ffyfox/dsh-linux-desktop#readme",
  "bugs": {
    "url": "https://github.com/ffyfox/dsh-linux-desktop/issues"
  }
}
